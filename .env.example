# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in: Supabase Dashboard → Project Settings → API.
#
# VITE_SUPABASE_URL is your project's URL (e.g. https://xxxxx.supabase.co).
# VITE_SUPABASE_PUBLISHABLE_KEY is the browser-safe "anon" / "publishable" key.
#
# Never put the "service_role" / secret key here — it must never reach the
# browser. .env.local is git-ignored; it is safe to put real values there,
# but this .env.example file should always stay blank.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
